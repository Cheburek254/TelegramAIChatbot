# Скопируйте в .env. Токен, ключи и пароль заполняются только там.
BOT_TOKEN=
POSTGRES_PASSWORD=
POSTGRES_DB=bot
POSTGRES_USER=bot

# Для Groq нужен GROQ_API_KEY. Для OpenRouter выберите LLM_PROVIDER=openrouter
# и задайте OPENROUTER_API_KEY. Если заполнены оба ключа, есть резервный провайдер.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Опциональный HTTP CONNECT или SOCKS5-прокси для Telegram.
TELEGRAM_PROXY_URL=

# Адрес PostgreSQL для запуска Python напрямую. В Compose бот использует db:5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Интеграция ИТМО через HTTPS выключена по умолчанию.
# HTTPS origin для веб-входа ИТМО и Telegram Mini App.
ITMO_AUTH_PUBLIC_URL=
ITMO_AUTH_PORT=8081

# Предпочтительная зона для календаря. Пользователь задаёт свою через /timezone.
MCP_RESOURCE_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
